{
  "name": "imessage-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run registry:build && next dev --port 3100",
    "registry:build": "bun scripts/build-registry.ts",
    "build": "bun run registry:build && next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test tests/e2e/interactions.spec.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "reference:compare": "bun scripts/compare-references.ts",
    "reference:import": "bun scripts/import-reference.ts",
    "test:registry": "bun scripts/test-registry.ts",
    "serve:test": "bun run build && bun run start --port 3101",
    "test:all": "playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:all:prod": "bun run build && (npx next start --port 3102 & sleep 12) && PLAYWRIGHT_BASE_URL=http://localhost:3102 playwright test; kill %1 2>/dev/null || true"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1",
    "@types/node": "^22",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@opennextjs/cloudflare": "^1.20.6",
    "wrangler": "^4.130.0"
  }
}
